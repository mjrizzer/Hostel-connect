rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.admin == true && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function owner() { return signedIn() && resource.data.sessionOwnerId == request.auth.uid; }
    match /buildings/{id} { allow read: if signedIn(); }
    match /machines/{id} { allow read: if signedIn(); }
    match /sportsEquipment/{id} { allow read: if signedIn(); }
    match /weeklyMenu/{id} { allow read: if signedIn(); }
    match /menuOverrides/{id} { allow read: if signedIn(); }
    match /chatMessages/{id} { allow read: if signedIn(); }
    match /users/{uid} { allow read: if signedIn() && (request.auth.uid == uid || admin()); }
    match /users/{uid}/tokens/{id} { allow read: if signedIn() && request.auth.uid == uid; }
    match /laundrySessions/{id} { allow read: if owner() || admin(); }
    match /sportsSessions/{id} { allow read: if owner() || admin(); }
    match /dryingReminders/{id} { allow read: if owner() || admin(); }
    match /menuSuggestions/{id} { allow read: if admin() || (signedIn() && resource.data.proposedBy == request.auth.uid); }
    match /{collection}/{id} {
      allow read: if admin() && collection in ['machineReports', 'sportsReports', 'messageReports', 'auditRecords', 'menuHistory', 'chatAuthors', 'restrictions'];
    }
    // All writes, role assignment, rate limits and task state are server-only.
    match /{document=**} { allow write: if false; }
  }
}
